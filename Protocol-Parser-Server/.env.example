MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=protocol_parser
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5

# 首次启动且users表为空时创建此管理员；创建后修改这里不会重置数据库密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 登录令牌签名密钥，部署时请替换为至少32位随机字符串
AUTH_SECRET=
AUTH_EXPIRE_HOURS=12

# 设备服务到期前多少天生成续费提醒
DEVICE_SERVICE_REMINDER_DAYS=30
